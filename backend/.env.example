# WealthGenie Backend Environment
# Copy to backend/.env. Never commit real credentials.

PORT=5001
NODE_ENV=development

# Supabase project URL and publishable (anon) key.
# The backend verifies user access tokens and uses user-scoped clients, so
# row-level security remains authoritative. Never use a service-role key here.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Legacy name still supported:
# SUPABASE_ANON_KEY=

# Optional: AI tutor configuration (loaded from the root .env if present)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
