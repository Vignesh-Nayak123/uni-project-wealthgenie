# WealthGenie Environment Configuration (root)
# Copy to .env and fill in your own values. Never commit real secrets.

PORT=5001
NODE_ENV=development

# Frontend API base URL (defaults to http://localhost:5001 if unset)
VITE_API_BASE_URL=http://localhost:5001
VITE_API_URL=http://localhost:5001

# AI Provider Configuration
# Set your own Google Gemini API key to enable live AI Financial Tutor capabilities.
# If empty, WealthGenie safely presents an honest unconfigured setup message.
GEMINI_API_KEY=
# Optional model override for the Gemini generateContent API.
GEMINI_MODEL=gemini-1.5-flash

# Supabase (backend). The publishable/anon key is safe for user-scoped access
# because row-level security is enforced. Never put a service-role key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Legacy name still supported:
# SUPABASE_ANON_KEY=
