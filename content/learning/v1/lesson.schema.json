{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wealthgenie.local/content/learning/v1/lesson.schema.json",
  "title": "WealthGenie Learning Lesson v1",
  "description": "Structural contract for reviewed learning content. Cross-document rules are enforced by backend/src/content/lessonContract.js.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contentVersion",
    "conceptId",
    "title",
    "branchId",
    "category",
    "status",
    "objectives",
    "prerequisites",
    "estimatedMinutes",
    "explanation",
    "examples",
    "keyTakeaways",
    "sourceIds",
    "review",
    "quiz",
    "disclaimer"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "contentVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "conceptId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "branchId": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "source-checked",
        "reviewed",
        "retired"
      ]
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/objective"
      }
    },
    "prerequisites": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "estimatedMinutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "explanation": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/example"
      }
    },
    "keyTakeaways": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sourceId"
      }
    },
    "review": {
      "$ref": "#/$defs/review"
    },
    "quiz": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/quiz"
      }
    },
    "disclaimer": {
      "type": "string",
      "minLength": 1
    },
    "generation": {
      "$ref": "#/$defs/generation"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$"
    },
    "sourceId": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9-]*$"
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "calculation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formula",
        "steps",
        "result"
      ],
      "properties": {
        "formula": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "result": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "text",
        "sourceIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sourceId"
          }
        },
        "calculation": {
          "$ref": "#/$defs/calculation"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceCheckedAt",
        "reviewedBy",
        "reviewedAt",
        "nextReviewAt"
      ],
      "properties": {
        "sourceCheckedAt": {
          "type": "string",
          "format": "date"
        },
        "reviewedBy": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "reviewedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "nextReviewAt": {
          "type": "string",
          "format": "date"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "quiz": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "objectiveId",
        "question",
        "options",
        "correctIndex",
        "explanation"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "objectiveId": {
          "$ref": "#/$defs/id"
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "correctIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assistedBy",
        "model",
        "promptVersion",
        "generatedAt"
      ],
      "properties": {
        "assistedBy": {
          "const": "gemini"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "promptVersion": {
          "type": "string",
          "minLength": 1
        },
        "generatedAt": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
