# WealthGenie Frontend Environment
# Copy to frontend/.env.local. Never commit real credentials.

# Supabase project URL and publishable (anon) key.
# Only publishable/anon keys belong in the browser. Never use a service-role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Legacy name still supported:
# VITE_SUPABASE_ANON_KEY=

# Optional: set this when the backend is not reachable through the Vite proxy.
# VITE_API_BASE_URL=http://localhost:5001
